# These values are used ONLY by Node scripts or GitHub Actions, NEVER in browser code.
# NEVER commit the real token or paste it into chat.
NOTION_TOKEN=replace_with_private_read_only_token
# Paste a database link or ID here (the importer resolves the data-source ID).
NOTION_DATABASE_ID=replace_with_database_link_or_id
# Optional: only needed if the database has multiple data sources.
# NOTION_DATA_SOURCE_ID=replace_with_specific_data_source_id
